# .env.example
# Runtime Environment Configuration for HotspotWatch v2

# Kafka
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=accident-reports
KAFKA_DLQ=accident-reports.dlq
KAFKA_PARTITIONS=6

# Hadoop / WebHDFS
WEBHDFS_URL=http://namenode:9870
HDFS_USER=root
HADOOP_CONF_DIR=/etc/hadoop

# API / Application
API_PORT=8000
VITE_MODE=live
STRICT_DAY_BARRIER=true
LATE_DAYS=3

# Logging & Monitoring
LOG_LEVEL=INFO
PROMETHEUS_METRICS_ENABLED=true
